{
  "rules": {
    ".read": false,
    ".write": false,

    "dias": {
      "$dia": {
        ".read": "auth != null && $dia.matches(/^[0-9]{4}-[0-9]{2}-[0-9]{2}$/)",

        "professores": {
          "$profId": {
            ".write": "auth != null && newData.exists() && $profId.matches(/^[a-z0-9-]{2,40}$/)",
            ".validate": "newData.hasChildren(['nome', 'materia', 'ativo', 'criadoEm'])",

            "nome":        { ".validate": "newData.isString() && newData.val().length >= 2 && newData.val().length <= 40" },
            "materia":     { ".validate": "newData.isString() && newData.val().length >= 2 && newData.val().length <= 40" },
            "ativo":       { ".validate": "newData.isBoolean()" },
            "criadoEm":    { ".validate": "newData.isNumber() && (data.exists() ? newData.val() == data.val() : newData.val() == now)" },
            "encerradoEm": { ".validate": "newData.isNumber()" },

            "$outro":      { ".validate": false }
          }
        },

        "chamados": {
          "$profId": {
            ".validate": "$profId.matches(/^[a-z0-9-]{2,40}$/)",

            "$chamadoId": {
              ".write": "auth != null && newData.exists()",
              ".validate": "newData.hasChildren(['turma', 'fiscal', 'status', 'criadoEm'])",

              "turma":        { ".validate": "newData.isString() && newData.val().matches(/^[0-9A-Za-z]{1,8}$/)" },
              "fiscal":       { ".validate": "newData.isString() && newData.val().length >= 2 && newData.val().length <= 40" },
              "status":       { ".validate": "newData.isString() && newData.val().matches(/^(pendente|atendido|cancelado)$/)" },
              "criadoEm":     { ".validate": "newData.isNumber() && (data.exists() ? newData.val() == data.val() : newData.val() == now)" },
              "ultimoEm":     { ".validate": "newData.isNumber()" },
              "insistencias": { ".validate": "newData.isNumber() && newData.val() >= 1 && newData.val() <= 20" },
              "atendidoEm":   { ".validate": "newData.isNumber()" },
              "atendidoPor":  { ".validate": "newData.isString() && newData.val().length <= 40" },

              "$outro":       { ".validate": false }
            }
          }
        },

        "$outroRamo": { ".validate": false }
      }
    }
  }
}
